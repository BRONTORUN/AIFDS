&HEAD CHID='street_fire', TITLE='Massive Row House Roof Fire with High Fidelity Details' /

! ==========================================================
! 1. 网格设置 (MESH) - 20个网格块
! ==========================================================
&MULT ID='mesh_mult', DX=5.0, DY=5.0, I_UPPER=3, J_UPPER=4 /
&MESH IJK=10,10,50, XB=-10.0,-5.0, -10.0,-5.0, 0.0,25.0,
      MULT_ID='mesh_mult' /

! ==========================================================
! 2. 仿真时间
! ==========================================================
&TIME T_END=60.0 /

! ==========================================================
! 3. 边界条件 (VENT)
! ==========================================================
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

! ==========================================================
! 4. 燃烧反应物 (REAC)
! ==========================================================
&REAC FUEL='PROPANE', SOOT_YIELD=0.15 /

! ==========================================================
! 5. 材质、颜色与火源表面
! ==========================================================
&SURF ID='BRICK_WALL', COLOR='FIREBRICK' /
&SURF ID='DARK_SIDING', COLOR='DIM GRAY' /
&SURF ID='LIGHT_SIDING', COLOR='WHEAT' /
&SURF ID='ORANGE_BASE', COLOR='CORAL' /
&SURF ID='ROOF', COLOR='BLACK' /
&SURF ID='STREET', COLOR='GRAY 50' /
&SURF ID='AWNING', COLOR='SLATE GRAY' /
&SURF ID='FIRE_ENGINE', COLOR='RED' /
&SURF ID='CAR', COLOR='SILVER' /
&SURF ID='POLE', COLOR='BLACK' /

! ----------------------------------------------------------
! 火源面积：
! A = (3.5 - (-3.5)) × (14.0 - 1.0)
!   = 7.0 × 13.0
!   = 91 m2
!
! 峰值热释放速率：
! Q = 91 × 1648.35165
!   ≈ 150000 kW
!   ≈ 150 MW
! ----------------------------------------------------------
&SURF ID='MASSIVE_FIRE',
      HRRPUA=1648.35165,
      RAMP_Q='FIRE_RAMP',
      COLOR='RED' /

! 0～20 s线性增长到150 MW，之后保持稳定
&RAMP ID='FIRE_RAMP', T=0.0,  F=0.0 /
&RAMP ID='FIRE_RAMP', T=20.0, F=1.0 /
&RAMP ID='FIRE_RAMP', T=60.0, F=1.0 /

! ==========================================================
! 6. 场景几何建模
! ==========================================================

! ----------------------------------------------------------
! 基础地形：前方街道
! ----------------------------------------------------------
&OBST XB=-10.0,10.0, -10.0,0.0, 0.0,0.1,
      SURF_ID='STREET' /

! ----------------------------------------------------------
! 前景右侧消防车
! ----------------------------------------------------------
&OBST XB=5.0,10.0, -9.0,-6.0, 0.1,3.0,
      SURF_ID='FIRE_ENGINE' /

! ----------------------------------------------------------
! 起火建筑前方的银色轿车
! ----------------------------------------------------------
&OBST XB=-0.5,3.5, -5.0,-3.0, 0.1,1.5,
      SURF_ID='CAR' /

! ----------------------------------------------------------
! 街道路灯杆
! ----------------------------------------------------------
&OBST XB=-0.5,0.0, -2.5,-2.0, 0.0,12.0,
      SURF_ID='POLE' /

! ==========================================================
! 左侧红砖建筑
! ==========================================================
&OBST XB=-10.0,-4.0, 0.0,15.0, 0.0,10.0,
      SURF_ID='BRICK_WALL' /

! 建筑内部掏空
&HOLE XB=-9.5,-4.5, 0.5,14.5, 0.5,9.5 /

! 一楼门窗
&HOLE XB=-9.5,-8.0, -0.5,0.5, 0.5,2.5 /
&HOLE XB=-6.5,-5.0, -0.5,0.5, 1.0,2.5 /

! 二楼窗户
&HOLE XB=-9.5,-8.5, -0.5,0.5, 4.0,6.0 /
&HOLE XB=-7.5,-6.5, -0.5,0.5, 4.0,6.0 /
&HOLE XB=-5.5,-4.5, -0.5,0.5, 4.0,6.0 /

! 三楼窗户
&HOLE XB=-9.5,-8.5, -0.5,0.5, 7.0,9.0 /
&HOLE XB=-7.5,-6.5, -0.5,0.5, 7.0,9.0 /
&HOLE XB=-5.5,-4.5, -0.5,0.5, 7.0,9.0 /

! ==========================================================
! 右侧浅色建筑
! ==========================================================
&OBST XB=4.0,10.0, 0.0,15.0, 0.0,10.0,
      SURF_ID='LIGHT_SIDING' /

! 建筑内部掏空
&HOLE XB=4.5,9.5, 0.5,14.5, 0.5,9.5 /

! 一楼橙红色底商表皮
&OBST XB=4.0,10.0, -0.5,0.0, 0.0,3.5,
      SURF_ID='ORANGE_BASE' /

! 多层塔楼或凸窗结构
&OBST XB=4.5,6.5, -1.0,0.0, 3.5,12.0,
      SURF_ID='LIGHT_SIDING' /

! 塔楼窗户
&HOLE XB=5.0,6.0, -1.5,0.5, 4.0,6.0 /
&HOLE XB=5.0,6.0, -1.5,0.5, 7.0,9.0 /
&HOLE XB=5.0,6.0, -1.5,0.5, 10.0,11.5 /

! 塔楼右侧普通窗户
&HOLE XB=7.5,9.0, -0.5,0.5, 4.0,6.0 /
&HOLE XB=7.5,9.0, -0.5,0.5, 7.0,9.0 /

! ==========================================================
! 中心起火建筑
! ==========================================================

! 建筑主体外壳
&OBST XB=-4.0,4.0, 0.0,15.0, 0.0,10.0,
      SURF_ID='DARK_SIDING' /

! 一楼上方遮阳篷或招牌
&OBST XB=-4.0,4.0, -1.5,0.0, 2.5,3.0,
      SURF_ID='AWNING' /

! 二、三层向外凸出的连排凸窗
&OBST XB=-3.5,3.5, -1.0,0.0, 3.5,9.5,
      SURF_ID='DARK_SIDING' /

! 建筑内部空间掏空
&HOLE XB=-3.5,3.5, 0.5,14.5, 0.5,9.5 /

! 屋顶烧穿开口
&HOLE XB=-3.0,3.0, 2.0,13.0, 9.5,10.5 /

! 三楼凸窗开口
&HOLE XB=-3.0,-1.5, -1.5,0.5, 7.0,9.0 /
&HOLE XB=-1.0, 1.0, -1.5,0.5, 7.0,9.0 /
&HOLE XB= 1.5, 3.0, -1.5,0.5, 7.0,9.0 /

! 二楼凸窗开口
&HOLE XB=-3.0,-1.5, -1.5,0.5, 4.0,6.0 /
&HOLE XB=-1.0, 1.0, -1.5,0.5, 4.0,6.0 /
&HOLE XB= 1.5, 3.0, -1.5,0.5, 4.0,6.0 /

! ==========================================================
! 7. 布置火源
! ==========================================================
! SURF_IDS顺序为顶部、侧面、底部。
! 仅火源板顶部燃烧。
!
! PERMIT_HOLE=.FALSE.：
! 防止建筑内部的HOLE将火源板一并删除。
&OBST ID='FIRE_SOURCE',
      XB=-3.5,3.5, 1.0,14.0, 6.0,6.5,
      SURF_IDS='MASSIVE_FIRE','INERT','INERT',
      PERMIT_HOLE=.FALSE. /

! ==========================================================
! 8. 数据输出
! ==========================================================

! X=0竖直剖面的温度和速度矢量
&SLCF PBX=0.0, QUANTITY='TEMPERATURE', VECTOR=.TRUE. /

! X=0竖直剖面的单位体积热释放速率
&SLCF PBX=0.0, QUANTITY='HRRPUV' /

! 障碍物表面温度
&BNDF QUANTITY='WALL TEMPERATURE' /

&TAIL /
