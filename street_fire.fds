&HEAD CHID='street_fire', TITLE='Massive Row House Roof Fire with High Fidelity Details' /

! ==========================================================
! 1. 网格设置 (MESH) - 20核并行
! ==========================================================
&MULT ID='mesh_mult', DX=5.0, DY=5.0, I_UPPER=3, J_UPPER=4 /
&MESH IJK=10,10,50, XB=-10.0,-5.0, -10.0,-5.0, 0.0,25.0, MULT_ID='mesh_mult' /

&TIME T_END=60.0 /

! ==========================================================
! 3. 边界条件 (VENT)
! ==========================================================
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

! ==========================================================
! 4. 燃烧反应物 (REAC) 
! ==========================================================
&REAC FUEL='PROPANE', SOOT_YIELD=0.15 /

! ==========================================================
! 5. 材质与颜色 (SURF) - 引入照片中的丰富色彩
! ==========================================================
&SURF ID='BRICK_WALL', COLOR='FIREBRICK' /   ! 左侧红砖
&SURF ID='DARK_SIDING', COLOR='DIM GRAY' /   ! 起火建筑深灰色
&SURF ID='LIGHT_SIDING', COLOR='WHEAT' /     ! 右侧浅色建筑
&SURF ID='ORANGE_BASE', COLOR='CORAL' /      ! [细节] 右侧建筑的一楼橙红色底商涂装
&SURF ID='ROOF', COLOR='BLACK' /             ! 屋顶
&SURF ID='STREET', COLOR='GRAY 50' /         ! 街道
&SURF ID='AWNING', COLOR='SLATE GRAY' /      ! 底商遮阳篷
&SURF ID='FIRE_ENGINE', COLOR='RED' /        ! 消防车
&SURF ID='CAR', COLOR='SILVER' /             ! [细节] 前景银色轿车
&SURF ID='POLE', COLOR='BLACK' /             ! [细节] 路灯杆

! 极致火源：2500 kW/m2
&SURF ID='MASSIVE_FIRE', HRRPUA=2500.0, COLOR='RED' / 

! ==========================================================
! 6. 场景几何建模 (OBST & HOLE) - 深度还原外立面
! ==========================================================
! [基础地形] 前方街道
&OBST XB=-10.0,10.0, -10.0,0.0, 0.0,0.1, SURF_ID='STREET' /

! [照片细节] 前景右侧停放的消防车 (右下角)
&OBST XB=5.0,10.0, -9.0,-6.0, 0.1,3.0, SURF_ID='FIRE_ENGINE' /

! [照片细节] 停在起火建筑正前方的银色轿车
&OBST XB=-0.5,3.5, -5.0,-3.0, 0.1,1.5, SURF_ID='CAR' /

! [照片细节] 街道上的路灯电线杆
&OBST XB=-0.5,0.0, -2.5,-2.0, 0.0,12.0, SURF_ID='POLE' /


! ---------------- 左侧红砖建筑 ----------------
&OBST XB=-10.0,-4.0, 0.0,15.0, 0.0,10.0, SURF_ID='BRICK_WALL' /
! 内部掏空
&HOLE XB=-9.5,-4.5, 0.5,14.5, 0.5,9.5 /
! [照片细节] 还原左侧红砖楼的三列特征窗户
! 1楼 (门面与大窗)
&HOLE XB=-9.5,-8.0, -0.5,0.5, 0.5,2.5 /
&HOLE XB=-6.5,-5.0, -0.5,0.5, 1.0,2.5 /
! 2楼 (三列窗户)
&HOLE XB=-9.5,-8.5, -0.5,0.5, 4.0,6.0 /
&HOLE XB=-7.5,-6.5, -0.5,0.5, 4.0,6.0 /
&HOLE XB=-5.5,-4.5, -0.5,0.5, 4.0,6.0 /
! 3楼 (三列窗户)
&HOLE XB=-9.5,-8.5, -0.5,0.5, 7.0,9.0 /
&HOLE XB=-7.5,-6.5, -0.5,0.5, 7.0,9.0 /
&HOLE XB=-5.5,-4.5, -0.5,0.5, 7.0,9.0 /


! ---------------- 右侧浅色建筑 ----------------
&OBST XB=4.0,10.0, 0.0,15.0, 0.0,10.0, SURF_ID='LIGHT_SIDING' /
! 内部掏空
&HOLE XB=4.5,9.5, 0.5,14.5, 0.5,9.5 /
! [照片细节] 一楼亮眼的橙红色底商涂装 (贴一层0.5m的表皮)
&OBST XB=4.0,10.0, -0.5,0.0, 0.0,3.5, SURF_ID='ORANGE_BASE' /
! [照片细节] 右侧建筑标志性的多层塔楼/凸窗结构 (Turret)
&OBST XB=4.5,6.5, -1.0,0.0, 3.5,12.0, SURF_ID='LIGHT_SIDING' /
! 塔楼内部掏空并开细长窗户
&HOLE XB=5.0,6.0, -1.5,0.5, 4.0,6.0 /
&HOLE XB=5.0,6.0, -1.5,0.5, 7.0,9.0 /
&HOLE XB=5.0,6.0, -1.5,0.5, 10.0,11.5 /
! 塔楼右侧的普通立面窗户
&HOLE XB=7.5,9.0, -0.5,0.5, 4.0,6.0 /
&HOLE XB=7.5,9.0, -0.5,0.5, 7.0,9.0 /


! ---------------- 中心起火建筑 ----------------
! 主体外壳
&OBST XB=-4.0,4.0, 0.0,15.0, 0.0,10.0, SURF_ID='DARK_SIDING' /
! [照片细节] 一楼上方伸出的遮阳篷/招牌
&OBST XB=-4.0,4.0, -1.5,0.0, 2.5,3.0, SURF_ID='AWNING' /
! [照片细节] 二三层外向凸出的大型连排凸窗结构 (Bay Windows)
&OBST XB=-3.5,3.5, -1.0,0.0, 3.5,9.5, SURF_ID='DARK_SIDING' /

! 内部空间掏空 (火场主战场)
&HOLE XB=-3.5,3.5, 0.5,14.5, 0.5,9.5 /

! 烧穿的巨大屋顶破洞 (冲天火焰由此而出)
&HOLE XB=-3.0,3.0, 2.0,13.0, 9.5,10.5 /

! [照片细节] 在凸窗上开孔，火苗将冲破这些窗户喷涌而出
! 3楼凸窗被大火突破
&HOLE XB=-3.0,-1.5, -1.5,0.5, 7.0,9.0 / 
&HOLE XB=-1.0, 1.0, -1.5,0.5, 7.0,9.0 / 
&HOLE XB= 1.5, 3.0, -1.5,0.5, 7.0,9.0 / 
! 2楼凸窗
&HOLE XB=-3.0,-1.5, -1.5,0.5, 4.0,6.0 / 
&HOLE XB=-1.0, 1.0, -1.5,0.5, 4.0,6.0 / 
&HOLE XB= 1.5, 3.0, -1.5,0.5, 4.0,6.0 / 


! ==========================================================
! 7. 布置火源 (Fire Source) - 150 MW 级破坏力
! ==========================================================
&OBST XB=-3.5,3.5, 1.0,14.0, 6.0,6.5, SURF_IDS='MASSIVE_FIRE','INERT','INERT' / 

! ==========================================================
! 8. 数据输出 (SLCF & BNDF)
! ==========================================================
&SLCF PBX=0.0, QUANTITY='TEMPERATURE', VECTOR=.TRUE. /
&SLCF PBX=0.0, QUANTITY='HRRPUV' /
&BNDF QUANTITY='WALL TEMPERATURE' /

&TAIL /