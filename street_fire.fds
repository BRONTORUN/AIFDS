&HEAD CHID='street_fire', TITLE='Photo-matched Street Vehicle Fire - Visible HRRPUV Flame Plume' /

! ==========================================================
! 1. 网格设置 (MESH) - 20块并行网格，覆盖整条街景
! ==========================================================
&MULT ID='mesh_mult', DX=5.0, DY=5.0, I_UPPER=3, J_UPPER=4 /
&MESH IJK=10,10,50, XB=-10.0,-5.0, -10.0,-5.0, 0.0,25.0, MULT_ID='mesh_mult' /

&TIME T_END=60.0 /
&RAMP ID='CAR_FIRE_RAMP', T=0.0, F=0.0 /
&RAMP ID='CAR_FIRE_RAMP', T=2.0, F=1.0 /
&DUMP DT_HRR=0.5, DT_SLCF=0.25, DT_BNDF=1.0, DT_SMOKE3D=0.25 /

! ==========================================================
! 2. 开边界条件 (VENT)
! ==========================================================
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

! ==========================================================
! 3. 燃烧反应物 (REAC)
! ==========================================================
&REAC FUEL='PROPANE', SOOT_YIELD=0.08 /

! ==========================================================
! 4. 材质与颜色 (SURF) - 按照片的真实相对颜色建模
! ==========================================================
&SURF ID='BRICK_WALL', COLOR='MAROON' /          ! 左侧深红砖楼
&SURF ID='BEIGE_SIDING', COLOR='TAN' /           ! 最左和一楼浅米色挂板
&SURF ID='DARK_SIDING', COLOR='BROWN' /          ! 中心深色排屋
&SURF ID='LIGHT_SIDING', COLOR='WHEAT' /         ! 右侧浅色塔楼排屋
&SURF ID='ORANGE_BASE', COLOR='CORAL' /          ! 右侧一层橙红色店面
&SURF ID='ROOF', COLOR='BLACK' /
&SURF ID='STREET', COLOR='GRAY 40' /
&SURF ID='SIDEWALK', COLOR='GRAY 70' /
&SURF ID='WINDOW_GLASS', COLOR='SKY BLUE' /
&SURF ID='WHITE_TRIM', COLOR='WHITE' /
&SURF ID='AWNING', COLOR='SLATE GRAY' /
&SURF ID='FIRE_ENGINE', COLOR='RED' /
&SURF ID='CAR', COLOR='SILVER' /
&SURF ID='FIREFIGHTER', COLOR='YELLOW' /
&SURF ID='POLE', COLOR='BLACK' /
&SURF ID='OVERHEAD_WIRE', COLOR='BLACK' /
&SURF ID='SIGN', COLOR='WHITE' /
&SURF ID='CAR_FIRE', HRRPUA=2500.0, COLOR='ORANGE', RAMP_Q='CAR_FIRE_RAMP' /

! ==========================================================
! 5. 场景几何建模 (OBST & HOLE) - 根据照片还原位置、形状、尺寸
! 坐标约定：X为街道横向，Y为进深，Z为高度；建筑正面在Y=0附近。
! ==========================================================
! 道路、路缘与人行道
&OBST XB=-10.0,10.0, -10.0,-3.0, 0.0,0.1, SURF_ID='STREET' /
&OBST XB=-10.0,10.0, -3.0,0.0, 0.0,0.18, SURF_ID='SIDEWALK' /

! 前景车辆与消防员：照片右下消防车、街中银色车、两名消防员
&OBST XB=6.2,10.0, -8.8,-5.3, 0.1,3.3, SURF_ID='FIRE_ENGINE' /
&OBST XB=1.0,4.0, -5.5,-3.5, 0.0,1.5, SURF_ID='CAR' /
&OBST XB=5.0,5.4, -5.7,-5.3, 0.0,1.9, SURF_ID='FIREFIGHTER' /
&OBST XB=7.1,7.5, -6.2,-5.8, 0.0,1.9, SURF_ID='FIREFIGHTER' /

! 路灯杆与照片中穿过火焰前景的电线
&OBST XB=0.15,0.45, -2.7,-2.4, 0.0,12.2, SURF_ID='POLE' /
&OBST XB=0.35,2.8, -2.55,-2.45, 11.0,11.2, SURF_ID='POLE' /
&OBST XB=-9.5,9.0, -2.35,-2.25, 10.0,10.12, SURF_ID='OVERHEAD_WIRE' /

! ---------------- 最左侧浅色建筑边缘 ----------------
&OBST XB=-10.0,-8.9, 0.0,13.0, 0.0,13.0, SURF_ID='BEIGE_SIDING' /
&HOLE XB=-9.9,-9.1, -0.4,0.4, 1.0,2.8 /

! ---------------- 左侧深红砖/挂板建筑 ----------------
&OBST XB=-8.9,-3.8, 0.0,14.0, 0.0,10.8, SURF_ID='BRICK_WALL' /
&HOLE XB=-8.5,-4.2, 0.5,13.5, 0.5,10.0 /
! 米色一层店面/住户基座
&OBST XB=-8.9,-3.8, -0.25,0.0, 0.0,3.0, SURF_ID='BEIGE_SIDING' /
! 三层窗户与白色窗框
&HOLE XB=-8.1,-7.1, -0.5,0.5, 1.0,2.6 /
&HOLE XB=-6.8,-5.8, -0.5,0.5, 1.0,2.6 /
&HOLE XB=-5.2,-4.4, -0.5,0.5, 1.0,2.8 /
&HOLE XB=-8.0,-7.0, -0.5,0.5, 4.1,6.1 /
&HOLE XB=-6.1,-5.2, -0.5,0.5, 4.1,6.1 /
&HOLE XB=-4.6,-4.0, -0.5,0.5, 4.1,6.1 /
&HOLE XB=-8.0,-7.0, -0.5,0.5, 7.4,9.4 /
&HOLE XB=-6.1,-5.2, -0.5,0.5, 7.4,9.4 /
&HOLE XB=-4.6,-4.0, -0.5,0.5, 7.4,9.4 /
&OBST XB=-8.9,-3.8, -1.0,0.0, 2.8,3.15, SURF_ID='AWNING' /

! ---------------- 中心建筑：深色三层排屋与二三层凸窗（本版不在建筑上燃烧） ----------------
&OBST XB=-3.8,3.8, 0.0,14.5, 0.0,10.2, SURF_ID='DARK_SIDING' /
&HOLE XB=-3.35,3.35, 0.5,14.0, 0.5,9.65 /
&OBST XB=-3.5,3.5, -1.05,0.0, 3.4,9.5, SURF_ID='DARK_SIDING' /
&OBST XB=-3.8,3.8, -1.35,0.0, 2.45,3.0, SURF_ID='AWNING' /
&OBST XB=-3.8,3.8, 0.0,14.5, 10.0,10.45, SURF_ID='ROOF' /
! 屋顶破洞仅作为照片几何保留，本版火源不在建筑上
&HOLE XB=-3.0,3.0, 2.0,12.8, 9.7,10.7 /
! 凸窗开口
&HOLE XB=-3.1,-1.6, -1.4,0.5, 4.1,6.2 /
&HOLE XB=-0.9, 0.9, -1.4,0.5, 4.1,6.2 /
&HOLE XB= 1.6, 3.1, -1.4,0.5, 4.1,6.2 /
&HOLE XB=-3.1,-1.6, -1.4,0.5, 7.1,9.2 /
&HOLE XB=-0.9, 0.9, -1.4,0.5, 7.1,9.2 /
&HOLE XB= 1.6, 3.1, -1.4,0.5, 7.1,9.2 /
! 白色窄窗框/门柱用于Smokeview中辨认照片比例
&OBST XB=-2.9,-2.75, -1.25,-1.15, 4.1,9.1, SURF_ID='WHITE_TRIM' /
&OBST XB=-0.08,0.08, -1.25,-1.15, 4.1,9.1, SURF_ID='WHITE_TRIM' /
&OBST XB=2.75,2.9, -1.25,-1.15, 4.1,9.1, SURF_ID='WHITE_TRIM' /

! ---------------- 右侧浅色建筑：橙色底商与圆角塔楼/凸窗 ----------------
&OBST XB=3.8,8.8, 0.0,13.8, 0.0,10.4, SURF_ID='LIGHT_SIDING' /
&HOLE XB=4.2,8.4, 0.5,13.3, 0.5,9.8 /
&OBST XB=3.8,8.8, -0.35,0.0, 0.0,3.4, SURF_ID='ORANGE_BASE' /
! 以多段矩形近似照片中的圆角塔楼
&OBST XB=4.3,6.3, -1.25,0.0, 3.0,11.4, SURF_ID='LIGHT_SIDING' /
&OBST XB=4.55,6.05, -1.55,-1.25, 3.0,11.1, SURF_ID='LIGHT_SIDING' /
&OBST XB=4.05,4.3, -0.9,-0.15, 3.0,10.9, SURF_ID='LIGHT_SIDING' /
&OBST XB=6.3,6.55, -0.9,-0.15, 3.0,10.9, SURF_ID='LIGHT_SIDING' /
&HOLE XB=4.8,5.8, -1.8,0.4, 4.0,5.7 /
&HOLE XB=4.8,5.8, -1.8,0.4, 6.6,8.2 /
&HOLE XB=4.8,5.8, -1.8,0.4, 9.0,10.6 /
&HOLE XB=7.0,8.1, -0.5,0.5, 4.0,5.8 /
&HOLE XB=7.0,8.1, -0.5,0.5, 6.8,8.6 /

! ---------------- 背景连续排屋与店招 ----------------
&OBST XB=8.8,10.0, 0.0,12.0, 0.0,8.8, SURF_ID='BEIGE_SIDING' /
&OBST XB=7.8,8.6, -0.4,-0.2, 3.4,6.4, SURF_ID='SIGN' /

! ==========================================================
! 6. 火源 (Fire Source)
! 按用户要求：火源不再放在建筑物、屋顶或窗口上，改为只在街道中的银色小汽车上燃烧。
! 银色小汽车位于 X=1.0~4.0、Y=-5.5~-3.5、Z=0.0~1.5；燃烧VENT贴在汽车顶面。
! 这些坐标与0.5 m网格面一致，可避免FDS把火源面贴合到错误位置而导致Smokeview看不到明火。
! ==========================================================
&VENT XB=1.5,3.5, -5.0,-4.0, 1.5,1.5, SURF_ID='CAR_FIRE' /

! ==========================================================
! 7. 数据输出 (SLCF & BNDF)
! ==========================================================
&SLCF PBX=2.5, QUANTITY='TEMPERATURE', VECTOR=.TRUE. /
&SLCF PBY=-4.5, QUANTITY='HRRPUV' /
&SLCF PBX=2.5, QUANTITY='HRRPUV' /
&SLCF PBZ=1.5, QUANTITY='HRRPUV' /
&SLCF PBZ=3.0, QUANTITY='HRRPUV' /
&BNDF QUANTITY='WALL TEMPERATURE' /

&TAIL /
